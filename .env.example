# -----------------------------------------------------------------------------
# Core infrastructure
# -----------------------------------------------------------------------------
POSTGRES_USER=saegyeol
POSTGRES_PASSWORD=replace-with-a-long-password
POSTGRES_DB=saegyeol
MINIO_ROOT_USER=saegyeol
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
S3_BUCKET=saegyeol-documents
OBJECT_STORE=s3
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Open WebUI -> workflow backend authentication
# Generate three different random values. Do not reuse them.
# -----------------------------------------------------------------------------
OPENWEBUI_BACKEND_KEY=sk-replace-openwebui-backend-key
OPENWEBUI_IDENTITY_JWT_SECRET=replace-with-at-least-32-random-bytes
OPENWEBUI_SECRET_KEY=replace-with-another-long-random-secret
OPENWEBUI_DEFAULT_TEAM_ID=lab
OPENWEBUI_ENABLE_SIGNUP=true
WEBUI_NAME=SaeGyeol Lab AI

# Optional service key for collection/document administration through /api.
LAB_ADMIN_API_KEY=sk-replace-admin-api-key
AUTH_MODE=openwebui
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# LiteLLM control plane
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-replace-master-key
# Generate once and never rotate after LiteLLM has encrypted stored credentials.
LITELLM_SALT_KEY=sk-replace-with-a-separate-persistent-salt
# During initial setup this may equal the master key. Replace it with a restricted
# LiteLLM virtual key before the lab pilot.
BACKEND_LITELLM_KEY=sk-replace-backend-virtual-key
LITELLM_KEYS_JSON={}
LITELLM_ROUTING_STRATEGY=least-busy
LITELLM_WORKERS=2
LITELLM_NUM_RETRIES=0
LITELLM_REQUEST_TIMEOUT=240
ALLOW_LOCAL_MODEL_FALLBACK=false
ALLOW_REMOTE_ROUTER_FALLBACK=false
LOCAL_ROUTER_MAX_TOKENS=64
LOCAL_ROUTER_MIN_CONFIDENCE=0.0
LOCAL_FAST_MAX_TOKENS=512

# -----------------------------------------------------------------------------
# Local model: select exactly one launch mode
# GPU/vLLM: LOCAL_BACKEND=vllm and use `docker compose --profile gpu ...`
# CPU/dev Ollama: LOCAL_BACKEND=ollama and use `docker compose --profile ollama ...`
# -----------------------------------------------------------------------------
LOCAL_BACKEND=vllm
LOCAL_MODEL_ID=Qwen/Qwen3-8B
LOCAL_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_GPU_COUNT=1
VLLM_API_KEY=local-vllm-key
HUGGING_FACE_HUB_TOKEN=
LOCAL_MODEL_EXTRA_JSON={}

OLLAMA_ROUTER_MODEL_ID=qwen3:0.6b
OLLAMA_MODEL_ID=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_API_BASE=http://ollama:11434

# -----------------------------------------------------------------------------
# Cloud model groups. All provider credentials live only in LiteLLM.
# -----------------------------------------------------------------------------
CLOUD_SMALL_MODEL=openai/gpt-5-mini
CLOUD_SMALL_API_KEY=
CLOUD_SMALL_API_BASE=
CLOUD_SMALL_EXTRA_JSON={}

CLOUD_LARGE_MODEL=openai/gpt-5
CLOUD_LARGE_API_KEY=
CLOUD_LARGE_API_BASE=
CLOUD_LARGE_EXTRA_JSON={}

EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_EXTRA_JSON={}
EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Runtime and RAG
# -----------------------------------------------------------------------------
LLM_TIMEOUT_SECONDS=240
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
RAG_TOP_K=8
RAG_CONTEXT_CHARS=18000
RAG_QUERY_CHARS=8000
CONVERSATION_HISTORY_MESSAGES=16
CONVERSATION_HISTORY_CHARS=24000
MAX_UPLOAD_MB=30

# -----------------------------------------------------------------------------
# Optional LiteLLM -> Langfuse callbacks
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# -----------------------------------------------------------------------------
# Optional website pull-request publisher
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_BASE_BRANCH=main
GITHUB_ALLOWED_PATHS=src/content,src/data,public

# Optional alternate OIDC / Cloudflare Access settings for direct API deployments.
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_USER_ID_CLAIM=sub
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_ROLES_CLAIM=roles
OIDC_TEAM_CLAIM=team_id

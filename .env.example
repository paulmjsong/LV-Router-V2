# -----------------------------------------------------------------------------
# Infonet AI Router — application
# -----------------------------------------------------------------------------
APP_NAME=Infonet AI Router
POSTGRES_USER=infonet
POSTGRES_PASSWORD=replace-with-a-long-password
POSTGRES_DB=infonet
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Open WebUI -> workflow backend authentication
# Generate different values. Do not reuse them.
# -----------------------------------------------------------------------------
OPENWEBUI_BACKEND_KEY=sk-replace-openwebui-backend-key
OPENWEBUI_IDENTITY_JWT_SECRET=replace-with-at-least-32-random-bytes
OPENWEBUI_SECRET_KEY=replace-with-another-long-random-secret
OPENWEBUI_DEFAULT_TEAM_ID=lab
OPENWEBUI_ENABLE_SIGNUP=true
WEBUI_NAME=Infonet AI Router
AUTH_MODE=openwebui

# Optional service key for direct administrative API use.
LAB_ADMIN_API_KEY=sk-replace-admin-api-key

# -----------------------------------------------------------------------------
# LiteLLM control plane
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-replace-master-key
LITELLM_SALT_KEY=sk-replace-with-a-separate-persistent-salt
# Initial local testing may use the master key here. Replace with a restricted
# virtual key before multi-user deployment.
BACKEND_LITELLM_KEY=sk-replace-backend-virtual-key
LITELLM_KEYS_JSON={}
LITELLM_ROUTING_STRATEGY=least-busy
LITELLM_WORKERS=1
LITELLM_NUM_RETRIES=0
LITELLM_REQUEST_TIMEOUT=240
ALLOW_LOCAL_MODEL_FALLBACK=false
ALLOW_REMOTE_ROUTER_FALLBACK=false

# Local semantic router. It classifies workflow + difficulty only.
LOCAL_ROUTER_MAX_TOKENS=64
LOCAL_ROUTER_MIN_CONFIDENCE=0.55
LOCAL_ROUTER_FALLBACK_TIER=cloud-small
LOCAL_FAST_MIN_CONFIDENCE=0.85
LOCAL_FAST_MAX_TOKENS=512

# -----------------------------------------------------------------------------
# Local model backend
# GPU/vLLM: LOCAL_BACKEND=vllm and use --profile gpu
# CPU/dev:  LOCAL_BACKEND=ollama and use --profile ollama
# -----------------------------------------------------------------------------
LOCAL_BACKEND=ollama
LOCAL_MODEL_ID=Qwen/Qwen3-8B
LOCAL_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_GPU_COUNT=1
VLLM_API_KEY=local-vllm-key
HUGGING_FACE_HUB_TOKEN=
LOCAL_MODEL_EXTRA_JSON={}

OLLAMA_ROUTER_MODEL_ID=qwen3:0.6b
OLLAMA_MODEL_ID=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_API_BASE=http://ollama:11434
OLLAMA_STARTUP_TIMEOUT_SECONDS=1800
OLLAMA_PRELOAD_TIMEOUT_SECONDS=300
LITELLM_START_PERIOD=20m

# -----------------------------------------------------------------------------
# Cloud model groups
# -----------------------------------------------------------------------------
CLOUD_SMALL_MODEL=openai/gpt-5-mini
CLOUD_SMALL_API_KEY=
CLOUD_SMALL_API_BASE=
CLOUD_SMALL_EXTRA_JSON={}

CLOUD_LARGE_MODEL=openai/gpt-5
CLOUD_LARGE_API_KEY=
CLOUD_LARGE_API_BASE=
CLOUD_LARGE_EXTRA_JSON={}

# -----------------------------------------------------------------------------
# GIST Regulations RAG
# IMPORTANT: the supplied FAISS index was built with text-embedding-3-small
# (1536 dimensions). Keep this compatible unless you rebuild the index.
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_EXTRA_JSON={}
EMBEDDING_DIMENSIONS=1536
GIST_REGULATIONS_INDEX_DIR=/app/jireumgil_index
GIST_REGULATIONS_TOP_K=5
GIST_REGULATIONS_VECTOR_DIMENSIONS=1536
GIST_REGULATIONS_CONTEXT_CHARS=16000

# Live web search (third-party ddgs client, DuckDuckGo backend)
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_REGION=us-en
WEB_SEARCH_SAFESEARCH=moderate
WEB_SEARCH_BACKEND=duckduckgo
WEB_SEARCH_PROXY=
WEB_SEARCH_QUERY_CHARS=1000
WEB_SEARCH_SNIPPET_CHARS=1200
WEB_SEARCH_CONTEXT_CHARS=12000

LLM_TIMEOUT_SECONDS=240
CONVERSATION_HISTORY_MESSAGES=16
CONVERSATION_HISTORY_CHARS=24000

# Optional LiteLLM -> Langfuse callbacks
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional OIDC / Cloudflare Access settings for direct API deployments.
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_USER_ID_CLAIM=sub
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_ROLES_CLAIM=roles
OIDC_TEAM_CLAIM=team_id
